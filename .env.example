# Local development defaults: copy to .env. Replace every secret before using this outside localhost.
# The password is embedded unescaped in DATABASE_URL: use only letters, digits, '_' and '-'.
POSTGRES_USER=blog_dev
POSTGRES_PASSWORD=local_demo_only_change_me_2026
POSTGRES_DB=xiaowork_blog
# Host-only ports, not public IP ports.
WEB_PORT=3000
API_PORT=8080
MAILPIT_UI_PORT=8025

# Browser-facing origin (no path). http is only accepted for localhost/127.0.0.1; production must be https.
PUBLIC_BASE_URL=http://127.0.0.1:3000
# >= 32 random bytes; keys CSRF tokens and rate-limit digests. This example value is rejected for non-local sites.
# Generate one with:  openssl rand -base64 48
APP_SECRET_KEY=local-dev-only-secret-change-me-0123456789

# SMTP: defaults send to the local Mailpit catcher (http://127.0.0.1:8025). For a real mailbox, e.g. a
# self-hosted domain mail server, set (TLS is mandatory outside localhost):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=starttls          # or tls (port 465)
# SMTP_USERNAME=no-reply@example.com
# SMTP_PASSWORD=             # never commit; prefer SMTP_PASSWORD_FILE with a mounted secret
# SMTP_FROM=XiaoWork Blog <no-reply@example.com>

# Image upload limits (defaults: 10 MiB / 20 MP for article & site images, 2 MiB / 2048² for avatars).
# MEDIA_MAX_BYTES=10485760
# MEDIA_MAX_PIXELS=20000000
# AVATAR_MAX_BYTES=2097152
# AVATAR_MAX_PIXELS=4194304

# X-Forwarded-For is trusted only from these networks (Docker networks of Nuxt / Nginx Proxy Manager).
# TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Optional build-time dependency sources; leave commented for the official defaults.
# Lockfiles (go.sum / pnpm-lock.yaml) still verify every downloaded package.
# GOPROXY=https://goproxy.cn,direct
# NPM_REGISTRY=https://registry.npmmirror.com/
