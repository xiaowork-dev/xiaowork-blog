# XiaoWork Blog — production settings. Copy to deploy/.env (chmod 600). deploy/.env is ignored by Git and
# must never be committed. install.sh creates it from this file and fills the generated secrets for you.
#
# Values marked CHANGE_ME are refused by the deploy scripts until they are replaced.
# Syntax is docker compose dotenv: KEY=value. Put a value containing $, #, spaces or quotes in single quotes
# (KEY='va$lue') — compose would otherwise expand $ — and keep single quotes out of the value itself.
# `deploy/manage.sh install` asks for these settings on a terminal and writes them quoted for you.

# ---- Site ----
# Browser-facing origin, https only, no path. Example: https://blog.example.com
PUBLIC_BASE_URL=https://CHANGE_ME.example.com

# Absolute host directory for persistent files: media/ (images), backups/, state/. Never inside the Git checkout.
DATA_DIR=/srv/xiaowork-blog

# ---- Database (internal network only, never published) ----
POSTGRES_USER=xiaowork_blog
POSTGRES_DB=xiaowork_blog
# Letters, digits, '_' and '-' only (it is embedded in the connection URL). install.sh generates one.
POSTGRES_PASSWORD=CHANGE_ME_GENERATED

# >= 32 random bytes; keys CSRF tokens and rate-limit digests. install.sh generates one (openssl rand -base64 48).
APP_SECRET_KEY=CHANGE_ME_GENERATED

# ---- Mail (verification and password-reset e-mails) ----
# TLS is mandatory for a public site: starttls (587) or tls (465).
SMTP_HOST=CHANGE_ME.smtp.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
# Put the real password here only on the server; never in Git, tickets or chat.
SMTP_PASSWORD=
SMTP_FROM=XiaoWork Blog <no-reply@example.com>

# ---- Reverse proxy ----
# Docker network of the existing Nginx Proxy Manager container (docker network ls). It must already exist.
PROXY_NETWORK=npm_default
# Subnet of this stack's own app network (Nuxt SSR -> API); change only if it collides with another network.
APP_SUBNET=172.30.240.0/24
# X-Forwarded-For is trusted only from these CIDRs (PROXY_NETWORK subnet + APP_SUBNET). Leave empty and
# install.sh / update.sh detect them with `docker network inspect`.
TRUSTED_PROXY_CIDRS=

# ---- Optional ----
# Image upload limits (defaults 10 MiB / 20 MP; avatars 2 MiB / 2048²).
# MEDIA_MAX_BYTES=10485760
# MEDIA_MAX_PIXELS=20000000
# AVATAR_MAX_BYTES=2097152
# AVATAR_MAX_PIXELS=4194304
# How many backups backup.sh keeps in DATA_DIR/backups (older ones are removed).
BACKUP_KEEP=14
# Build-time mirrors (optional): GOPROXY=https://goproxy.cn,direct  NPM_REGISTRY=https://registry.npmmirror.com/
# GOPROXY=
# NPM_REGISTRY=
